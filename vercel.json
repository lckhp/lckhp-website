{
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/register",
      "destination": "https://forms.gle/b7gmsnXeQTGjRCAx8",
      "permanent": true
    },
    {
      "source": "/directory",
      "destination": "/donate",
      "permanent": true
    },
    {
      "source": "/directory/orphanages",
      "destination": "/donate/orphanages",
      "permanent": true
    },
    {
      "source": "/directory/blood-bank",
      "destination": "/donate/blood-bank",
      "permanent": true
    },
    {
      "source": "/directory/blood-banks",
      "destination": "/donate/blood-bank",
      "permanent": true
    },
    {
      "source": "/directory/old-age-homes",
      "destination": "/donate/old-age-homes",
      "permanent": true
    },
    {
      "source": "/www.:path(.*)",
      "destination": "/:path*",
      "permanent": true
    },
    {
      "source": "/contact",
      "destination": "/#contact-section",
      "permanent": true
    },
    {
      "source": "/tag/:tag",
      "destination": "https://blog.lckhp.org/",
      "permanent": false
    },
    {
      "source": "/:path*/rss.xml",
      "destination": "https://blog.lckhp.org/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "index, follow" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/:path(.*)\\.(xml)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    },
    {
      "source": "/tag/:tag",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    }
  ]
}
