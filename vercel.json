{
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/:path*/",
      "destination": "/:path*",
      "permanent": true
    },
    {
      "source": "http://lckhp.org/:path*",
      "destination": "https://lckhp.org/:path*",
      "permanent": true
    },
    {
      "source": "http://www.lckhp.org/:path*",
      "destination": "https://lckhp.org/:path*",
      "permanent": true
    },
    {
      "source": "https://www.lckhp.org/:path*",
      "destination": "https://lckhp.org/:path*",
      "permanent": true
    },
    {
      "source": "/register",
      "destination": "https://forms.gle/b7gmsnXeQTGjRCAx8",
      "permanent": true
    },
    {
      "source": "/directory",
      "destination": "/donate",
      "permanent": true
    },
    {
      "source": "/directory/orphanages",
      "destination": "/donate/orphanages",
      "permanent": true
    },
    {
      "source": "/directory/blood-bank",
      "destination": "/donate/blood-bank",
      "permanent": true
    },
    {
      "source": "/directory/blood-banks",
      "destination": "/donate/blood-bank",
      "permanent": true
    },
    {
      "source": "/directory/old-age-homes",
      "destination": "/donate/old-age-homes",
      "permanent": true
    },
    {
      "source": "/contact",
      "destination": "/#contact-section",
      "permanent": true
    },
    {
      "source": "/tag/:tag",
      "destination": "https://blog.lckhp.org/",
      "permanent": false
    },
    {
      "source": "/:path*/rss.xml",
      "destination": "https://blog.lckhp.org/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "index, follow" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "X-Robots-Tag", "value": "index, follow" },
        { "key": "Link", "value": "<https://lckhp.org>; rel=\"canonical\"" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/2425/calendar",
      "headers": [
        { "key": "X-Robots-Tag", "value": "index, follow" },
        {
          "key": "Link",
          "value": "<https://lckhp.org/2425/calendar>; rel=\"canonical\""
        }
      ]
    },
    {
      "source": "/resources",
      "headers": [
        { "key": "X-Robots-Tag", "value": "index, follow" },
        {
          "key": "Link",
          "value": "<https://lckhp.org/resources>; rel=\"canonical\""
        }
      ]
    },
    {
      "source": "/resources-page",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/2425/members/:id",
      "headers": [
        { "key": "X-Robots-Tag", "value": "index, follow" },
        {
          "key": "Link",
          "value": "<https://lckhp.org/2425/members/:id>; rel=\"canonical\""
        }
      ]
    },
    {
      "source": "/:path(.*)\\.(xml)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    },
    {
      "source": "/tag/:tag",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    },
    {
      "source": "/blog.lckhp.org/tag/:tag",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    },
    {
      "source": "/donate",
      "headers": [
        { "key": "X-Robots-Tag", "value": "index, follow" },
        {
          "key": "Link",
          "value": "<https://lckhp.org/donate>; rel=\"canonical\""
        }
      ]
    },
    {
      "source": "/donate/:category",
      "headers": [
        { "key": "X-Robots-Tag", "value": "index, follow" },
        {
          "key": "Link",
          "value": "<https://lckhp.org/donate/:category>; rel=\"canonical\""
        }
      ]
    }
  ]
}
